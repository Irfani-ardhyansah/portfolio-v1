---
import { site } from '../data/site';
import { withBase } from '../lib/asset';

interface Props {
	variant?: 'home' | 'inner';
}

const { variant = 'home' } = Astro.props;
const root = withBase('');
---

<header
	class="sticky top-0 z-40 border-b border-border/70 bg-bg/75 backdrop-blur-md"
>
	<nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 md:px-8">
		<a href={variant === 'home' ? '#top' : root} class="font-mono text-sm font-medium tracking-wide text-text">
			<span class="text-accent">~/</span>{site.name.toLowerCase()}
		</a>

		<button
			id="nav-toggle"
			type="button"
			class="inline-flex items-center rounded-md border border-border px-3 py-1.5 font-mono text-xs text-muted md:hidden"
			aria-expanded="false"
			aria-controls="nav-menu"
		>
			Menu
		</button>

		<ul
			id="nav-menu"
			class="absolute left-0 right-0 top-full hidden flex-col gap-1 border-b border-border bg-bg/95 px-5 py-4 backdrop-blur-md md:static md:flex md:flex-row md:items-center md:gap-6 md:border-0 md:bg-transparent md:p-0"
		>
			{
				site.nav.map((item) => {
					const href =
						variant === 'home'
							? item.href
							: item.href.startsWith('#')
								? `${root}${item.href}`
								: withBase(item.href);
					return (
						<li>
							<a
								href={href}
								class="nav-link block py-2 font-mono text-sm text-muted transition hover:text-accent md:py-0"
							>
								{item.label}
							</a>
						</li>
					);
				})
			}
			<li>
				<a
					href={withBase('work')}
					class="nav-link block py-2 font-mono text-sm text-muted transition hover:text-accent md:py-0"
				>
					All work
				</a>
			</li>
		</ul>
	</nav>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const menu = document.getElementById('nav-menu');

	toggle?.addEventListener('click', () => {
		const open = menu?.classList.toggle('hidden') === false;
		toggle.setAttribute('aria-expanded', String(open));
		if (open) menu?.classList.add('flex');
		else menu?.classList.remove('flex');
	});

	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			if (window.matchMedia('(max-width: 767px)').matches) {
				menu.classList.add('hidden');
				menu.classList.remove('flex');
				toggle?.setAttribute('aria-expanded', 'false');
			}
		});
	});
</script>
