---
import { site } from '../data/site';
---

<section id="services" class="border-t border-border/60">
	<div class="section-shell">
		<p class="section-label">Services</p>
		<h2 class="section-title">What I can help with</h2>
		<p class="mt-3 max-w-2xl text-muted">
			Freelance help available per project or as a short retainer.
		</p>
		<ul class="mt-10 grid gap-6 md:grid-cols-3">
			{
				site.services.map((service) => (
					<li class="glass-card p-6">
						<h3 class="text-lg font-medium text-text">{service.title}</h3>
						<p class="mt-3 text-sm leading-relaxed text-muted">{service.description}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
