---
import { site } from '../data/site';
---

<section id="contact" class="border-t border-border/60">
	<div class="section-shell">
		<p class="section-label">Contact</p>
		<h2 class="section-title">{site.contact.headline}</h2>
		<p class="mt-3 max-w-xl text-muted">{site.contact.body}</p>

		<div class="mt-8 flex flex-wrap gap-3">
			<a
				class="btn-primary whitespace-normal text-center sm:whitespace-nowrap"
				href="#contact"
				id="contact-email-cta"
				data-u={site.contact.emailUser}
				data-d={site.contact.emailDomain}
			>
				<span class="hidden sm:inline">{site.ctas.secondary.label}</span>
				<span class="sm:hidden">{site.ctas.secondary.labelShort}</span>
			</a>
			<a
				class="btn-secondary"
				href="#contact"
				id="contact-wa-cta"
				data-wa={site.contact.waDigits}
				target="_blank"
				rel="noopener noreferrer"
			>
				WhatsApp
			</a>
		</div>

		<ul class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-6">
			<li>
				<a
					id="contact-email-link"
					class="inline-flex items-center gap-2 font-mono text-sm text-muted transition hover:text-accent"
					href="#contact"
					data-u={site.contact.emailUser}
					data-d={site.contact.emailDomain}
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-accent" aria-hidden="true">
						<rect x="2" y="4" width="20" height="16" rx="2"></rect>
						<path d="m22 7-10 7L2 7"></path>
					</svg>
					<span data-email-label>Email</span>
				</a>
			</li>
			<li>
				<a
					id="contact-wa-link"
					class="inline-flex items-center gap-2 font-mono text-sm text-muted transition hover:text-accent"
					href="#contact"
					data-wa={site.contact.waDigits}
					data-label={site.contact.phoneDisplay}
					target="_blank"
					rel="noopener noreferrer"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-accent" aria-hidden="true">
						<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
					</svg>
					<span data-wa-label>WhatsApp</span>
				</a>
			</li>
		</ul>

		<ul class="mt-10 flex flex-wrap gap-4 font-mono text-sm text-muted">
			{
				site.contact.socials.map((social) => (
					<li>
						<a
							href={social.href}
							target="_blank"
							rel="noopener noreferrer"
							class="transition hover:text-accent"
						>
							{social.label} ↗
						</a>
					</li>
				))
			}
		</ul>

		<p class="mt-16 font-mono text-xs text-muted/70">
			© {new Date().getFullYear()} {site.name} · {site.fullName}. Built with Astro.
		</p>
	</div>
</section>

<script>
	function wireEmail(el: HTMLAnchorElement | null) {
		if (!el) return;
		const user = el.dataset.u;
		const domain = el.dataset.d;
		if (!user || !domain) return;
		const email = `${user}@${domain}`;
		el.href = `mailto:${email}`;
		const label = el.querySelector('[data-email-label]');
		if (label) label.textContent = email;
	}

	function wireWa(el: HTMLAnchorElement | null) {
		if (!el) return;
		const digits = el.dataset.wa;
		if (!digits) return;
		el.href = `https://wa.me/${digits}`;
		const label = el.querySelector('[data-wa-label]');
		const display = el.dataset.label;
		if (label && display) label.textContent = display;
	}

	wireEmail(document.getElementById('contact-email-cta') as HTMLAnchorElement | null);
	wireEmail(document.getElementById('contact-email-link') as HTMLAnchorElement | null);
	wireWa(document.getElementById('contact-wa-cta') as HTMLAnchorElement | null);
	wireWa(document.getElementById('contact-wa-link') as HTMLAnchorElement | null);
</script>
