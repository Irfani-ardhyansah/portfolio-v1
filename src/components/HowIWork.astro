---
import { site } from '../data/site';
---

<section id="process" class="border-t border-border/60">
	<div class="section-shell">
		<p class="section-label">Process</p>
		<h2 class="section-title">{site.process.title}</h2>
		<p class="mt-3 max-w-2xl text-muted">{site.process.subtitle}</p>

		<ol class="mt-10 grid items-stretch gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{
				site.process.steps.map((step, index) => (
					<li class="glass-card flex h-full flex-col p-5">
						<p class="font-mono text-xs text-accent">
							{String(index + 1).padStart(2, '0')} — {step.title}
						</p>
						<p class="mt-3 text-sm leading-relaxed text-muted">{step.detail}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
