---
import { site } from '../data/site';
---

<section id="beyond" class="border-t border-border/60">
	<div class="section-shell">
		<p class="section-label">{site.beyondCode.title}</p>
		<h2 class="section-title">{site.beyondCode.subtitle}</h2>
		<p class="mt-3 max-w-2xl text-muted">{site.beyondCode.intro}</p>

		<div class="mt-10 grid items-stretch gap-8 lg:grid-cols-2">
			<div class="glass-card overflow-hidden">
				<img
					src={site.beyondCode.image}
					alt={site.beyondCode.imageAlt}
					class="h-full min-h-[280px] w-full object-cover"
					loading="lazy"
				/>
			</div>
			<ul class="flex flex-col gap-4">
				{
					site.beyondCode.points.map((point, index) => (
						<li class="glass-card p-5">
							<p class="font-mono text-xs text-accent">
								{String(index + 1).padStart(2, '0')} — {point.label}
							</p>
							<p class="mt-2 text-sm leading-relaxed text-muted">{point.detail}</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
