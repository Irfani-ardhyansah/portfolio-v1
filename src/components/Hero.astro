---
import { site } from '../data/site';
---

<section id="top" class="relative overflow-hidden">
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgb(34_211_238_/_0.12),_transparent_55%)]"
		aria-hidden="true"
	>
	</div>
	<div class="section-shell relative flex min-h-[78vh] flex-col justify-center">
		<p class="mb-4 font-mono text-xs uppercase tracking-[0.22em] text-accent">
			available for freelance / full-time
		</p>
		<h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-text md:text-6xl">
			{site.headline}
		</h1>
		<p class="mt-5 max-w-2xl text-base leading-relaxed text-muted md:text-lg">
			{site.subheadline}
		</p>
		<div class="mt-9 flex flex-wrap gap-3">
			<a class="btn-primary" href={site.ctas.primary.href}>{site.ctas.primary.label}</a>
			<a class="btn-secondary" href={site.ctas.secondary.href}>{site.ctas.secondary.label}</a>
		</div>
	</div>
</section>
