---
import { site } from '../data/site';
---

<section id="top" class="relative overflow-hidden">
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgb(34_211_238_/_0.10),_transparent_50%)]"
		aria-hidden="true"
	>
	</div>
	<div class="section-shell relative">
		<div class="grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-12">
			<div class="flex min-h-0 flex-col justify-center py-6 md:py-10">
				<p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">
					available for freelance / full-time
				</p>
				<p class="mt-2 font-mono text-[11px] tracking-wide text-muted/80">
					<span class="text-accent/70">●</span> {site.availability}
				</p>
				<h1 class="mt-5 max-w-3xl text-4xl font-semibold tracking-tight text-text md:text-6xl">
					{site.headline}
				</h1>
				<p class="mt-5 max-w-2xl text-base leading-relaxed text-muted md:text-lg">
					{site.subheadline}
				</p>
				<p class="mt-4 max-w-2xl text-base leading-relaxed text-muted md:text-lg">
					{
						site.valueProp.map((part) =>
							part.accent ? (
								<strong class="font-semibold text-accent">{part.text}</strong>
							) : (
								part.text
							),
						)
					}
				</p>
				<div class="mt-9 flex flex-wrap gap-3">
					<a class="btn-primary" href={site.ctas.primary.href}>{site.ctas.primary.label}</a>
					<a class="btn-secondary whitespace-normal text-center sm:whitespace-nowrap" href={site.ctas.secondary.href}>
						<span class="hidden sm:inline">{site.ctas.secondary.label}</span>
						<span class="sm:hidden">{site.ctas.secondary.labelShort}</span>
					</a>
				</div>
			</div>

			<aside class="hidden lg:block" aria-hidden="true">
				<div class="overflow-hidden rounded-lg border border-border bg-surface/80 shadow-[0_0_40px_rgb(34_211_238_/_0.06)] backdrop-blur-md">
					<div class="flex items-center gap-2 border-b border-border px-4 py-2.5">
						<span class="size-2.5 rounded-full bg-[#ff5f56]"></span>
						<span class="size-2.5 rounded-full bg-[#ffbd2e]"></span>
						<span class="size-2.5 rounded-full bg-[#27c93f]"></span>
						<span class="ml-2 font-mono text-[11px] text-muted">snippet — status.sh</span>
					</div>
					<div class="space-y-1.5 px-4 py-4 font-mono text-xs leading-relaxed text-muted">
						<p><span class="text-accent">&gt;</span> whoami</p>
						<p class="pl-3 text-text">{site.name.toLowerCase()} · {site.role.toLowerCase()}</p>
						<p><span class="text-accent">&gt;</span> uptime --role</p>
						<p class="pl-3">4+ yrs shipping web systems</p>
						<p><span class="text-accent">&gt;</span> status --poc</p>
						<p class="pl-3 text-accent">ok · liaison 1.5 yrs</p>
						<p class="text-accent/80">█</p>
					</div>
				</div>
			</aside>
		</div>

		<ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:mt-2 lg:grid-cols-4">
			{
				site.stats.map((stat) => (
					<li class="glass-card px-4 py-3">
						<p class="font-mono text-xl font-medium text-accent md:text-2xl">{stat.value}</p>
						<p class="mt-1 font-mono text-[11px] uppercase tracking-wider text-muted">
							{stat.label}
						</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
