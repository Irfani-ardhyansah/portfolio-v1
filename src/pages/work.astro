---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import WorkCatalogSection from '../components/WorkCatalogSection.astro';
import CareerProgression from '../components/CareerProgression.astro';
import { site } from '../data/site';
import { withBase } from '../lib/asset';
---

<BaseLayout title={`Work — ${site.headline}`} description={site.description}>
	<Navbar variant="inner" />
	<main id="main" class="section-shell !py-12 md:!py-16">
		<p class="section-label">Work</p>
		<h1 class="section-title">All projects</h1>
		<p class="mt-3 max-w-2xl text-muted">
			Professional delivery, freelance work, and earlier projects — aligned with my CV.
		</p>
		<p class="mt-4">
			<a href={withBase('')} class="font-mono text-sm text-accent transition hover:underline">
				← Back to home
			</a>
		</p>

		<CareerProgression />
		<WorkCatalogSection title="Professional Work" items={site.workCatalog.professional} />
		<WorkCatalogSection title="Freelance Projects" items={site.workCatalog.freelance} />
		<WorkCatalogSection title="Personal & Side Projects" items={site.workCatalog.personal} />
	</main>

	<footer class="border-t border-border/60">
		<div class="section-shell !py-10">
			<p class="font-mono text-xs text-muted/70">
				© {new Date().getFullYear()} {site.name} · {site.fullName}. Based in {site.location}.
			</p>
		</div>
	</footer>
</BaseLayout>
